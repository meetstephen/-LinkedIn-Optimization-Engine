# ══════════════════════════════════════════════════════════════
# LinkedEdge — Environment Variables
# Copy this file to .env (locally) or paste into Streamlit Cloud
# Settings → Secrets (recommended for deployment).
# ══════════════════════════════════════════════════════════════

# ── Required ────────────────────────────────────────────────────
# Google Gemini API key — powers every text feature.
# Get one (free tier: 60 req/min, 1M tokens/day on Gemini 2.5 Flash):
#   https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here


# ── Optional: Image generation (Image Generator module) ─────────
# Stability AI — primary image engine (SDXL).
#   https://platform.stability.ai/account/keys
STABILITY_API_KEY=your_stability_ai_key_here

# Hugging Face — fallback image engine.
# NOTE: the variable name MUST be HF_API_KEY (not HUGGING_FACE_API_KEY) —
# the app reads HF_API_KEY from env / st.secrets.
#   https://huggingface.co/settings/tokens
HF_API_KEY=your_hugging_face_key_here


# ── Optional: Persistent Post Library (Supabase) ────────────────
# When set, every saved post + your profile survive reboots and
# refreshes. Without these, the library is session-only.
#   https://supabase.com/dashboard
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_supabase_anon_key
