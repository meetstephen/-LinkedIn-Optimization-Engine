# ══════════════════════════════════════════════════════════════
# LinkedEdge — Environment Variables
# Copy this file to .env (locally) or paste into Streamlit Cloud
# Settings → Secrets (recommended for deployment).
# ══════════════════════════════════════════════════════════════

# ── Required ────────────────────────────────────────────────────
# Google Gemini API key — powers every text feature.
# Get one (free tier: 60 req/min, 1M tokens/day on Gemini 2.5 Flash):
#   https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here


# ── Optional: Access control ────────────────────────────────────
# Whether to require sign-in before any feature page renders.
# Defaults to TRUE — strongly recommended for any public deployment so
# anonymous traffic can't burn the owner's shared API key/quota.
# Set to "false" only for a personal single-user instance or a local
# demo where open access is acceptable.
# REQUIRE_AUTH=true


# ── Optional: Image generation (Image Generator module) ─────────
# Stability AI — primary image engine (SDXL).
#   https://platform.stability.ai/account/keys
STABILITY_API_KEY=your_stability_ai_key_here

# Hugging Face — fallback image engine.
# NOTE: the variable name MUST be HF_API_KEY (not HUGGING_FACE_API_KEY) —
# the app reads HF_API_KEY from env / st.secrets.
#   https://huggingface.co/settings/tokens
HF_API_KEY=your_hugging_face_key_here


# ── Optional: Persistent Post Library (Supabase) ────────────────
# When set, every saved post + your profile survive reboots and
# refreshes. Without these, the library is session-only.
#   https://supabase.com/dashboard
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_supabase_anon_key


# ── Optional: First-admin bootstrap ─────────────────────────────
# When this email signs up for the very first time, the new account
# is automatically promoted to admin and gains access to the
# 🛡️ Admin Console (user list, login feed, promote/deactivate, etc).
# Leave blank to disable bootstrapping (you can still flip is_admin
# manually via the Supabase Table Editor).
BOOTSTRAP_ADMIN_EMAIL=you@example.com


# ── Optional: Login security knobs ──────────────────────────────
# Block login attempts from an email that has accumulated this many
# failed attempts within LOGIN_FAIL_WINDOW_MIN minutes. Defaults are
# sensible — only override if you understand the trade-off.
# LOGIN_FAIL_THRESHOLD=5
# LOGIN_FAIL_WINDOW_MIN=15

# Force re-login after this many days of inactivity (default 30).
# SESSION_INACTIVITY_DAYS=30


# ── Optional: Password reset ────────────────────────────────────
# Public URL of the deployed app — used in the password-reset email
# (e.g. https://linkedge.streamlit.app).  When unset the reset URL
# falls back to a relative path which won't work from inside an
# email client — so set this before going public.
APP_BASE_URL=https://your-app.streamlit.app

# How long a reset token stays valid (default 24 hours).
# PASSWORD_RESET_TTL_HOURS=24

# SendGrid v3 API key. When set, password reset emails are delivered
# via SendGrid. When unset, the request still succeeds (no account
# enumeration) but no email goes out.
#   https://app.sendgrid.com/settings/api_keys
SENDGRID_API_KEY=

# From-address for SendGrid email. Must match a verified sender on
# your SendGrid account.
SENDGRID_FROM_EMAIL=no-reply@your-domain.com

# Local-development convenience: when set to "1", any password reset
# request that fails to send via SendGrid will instead surface the
# raw URL inside the auth gateway (under a "Developer link" expander)
# so the flow can be tested end-to-end without an inbox.
# DO NOT enable this in production — it lets anyone with access to
# the form harvest reset URLs.
# ALLOW_DEV_RESET_LINK=0
